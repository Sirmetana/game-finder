# Copier ce fichier en .env et remplir les valeurs (le .env n'est jamais commité)

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=game_finder
DB_USERNAME=game_finder
DB_PASSWORD=change-me

# JPA (optionnel)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Clé RAWG : https://rawg.io/apidocs
RAWG_API_KEY=your-rawg-api-key
